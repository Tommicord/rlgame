#version 450

shared int cachedPerm[256];
shared int cachedPermGradIndex3D[256];

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 12) buffer PermutationBuffer {
    int perm[256];
};

layout(std430, binding = 13) buffer PermGradIndex3DBuffer {
    int permGradIndex3D[256];
};

#include "SimplexNoise.glsl"

struct UnitData
{
    uint typeId;
    float elevationMin;
    float elevationMax;
    float moistureMin;
    float moistureMax;
    float temperatureMin;
    float temperatureMax;
    float equatorMin;
    float equatorMax;
    uint _padding0;
    uint _padding1;
    uint _padding2;
};

struct BiomeData
{
    uint typeId;
    float elevationMin;
    float elevationMax;
    float moistureMin;
    float moistureMax;
    float temperatureMin;
    float temperatureMax;
    float equatorMin;
    float equatorMax;
    uint _padding0;
    uint _padding1;
    uint _padding2;
};

shared UnitData cachedUnits[64];
shared BiomeData cachedBiomes[64];

layout(std430, binding = 0) buffer UnitRegistryBuffer
{
    UnitData units[];
};

layout(std430, binding = 1) buffer BiomeRegistryBuffer
{
    BiomeData biomes[];
};

struct PlanetData
{
    vec3 center;
    float radius;
    vec3 axis;
    float mass;
    vec3 velocity;
    float gravity;
    float baseTemperature;
    float baseMoisture;
    float atmosphereHeight;
    uint seed;
    uint shapeType;
    uint _padding[2];
};

layout(push_constant) uniform UnitPlacePushConstants
{
    vec3 worldOrigin;
    uint _padding0;
    uint width;
    uint height;
    uint depth;
    float texelSize;
    uint airUnitId;
    uint unitRegistryCount;
    uint biomeRegistryCount;
    float groundLevel;
    uint _padding[1];
} pc;

layout(std430, binding = 2) buffer PlanetBuffer
{
    PlanetData planet;
};

layout(r8, binding = 3) uniform image2D basemapElevationImage;
layout(r8, binding = 4) uniform image2D basemapTemperatureImage;
layout(r8, binding = 5) uniform image2D basemapMoistureImage;

layout(r8, binding = 6) uniform image3D deepmapElevationImage;
layout(r8, binding = 7) uniform image3D deepmapTemperatureImage;
layout(r8, binding = 8) uniform image3D deepmapMoistureImage;

layout(rgba8, binding = 9) uniform image2D equatorImage;

layout(r32ui, binding = 10) uniform uimage3D unitOutputImage;

layout(r32ui, binding = 11) uniform uimage3D biomeOutputImage;

bool isInRange(float value, float minRange, float maxRange)
{
    return value >= minRange && value <= maxRange;
}

float getRangeFit(float value, float minRange, float maxRange)
{
    float tolerance = 0.1111;
    if (value < minRange - tolerance || value > maxRange + tolerance)
    {
        return 0.0;
    }

    float range = maxRange - minRange;
    if (range <= 0.0) return 1.0;

    float center = (minRange + maxRange) * 0.5;
    float distance = abs(value - center);
    float normalizedDistance = distance / (range * 0.5);

    float fit = max(0.0, 1.0 - normalizedDistance);
    float rangePenalty = 1.0 - min(0.5, range * 0.5);

    return fit * rangePenalty;
}

vec4 getRangeFitVec4(vec4 value, vec4 minRange, vec4 maxRange)
{
    vec4 tolerance = vec4(0.1111);
    bvec4 inRangeLower = greaterThanEqual(value, minRange - tolerance);
    bvec4 inRangeUpper = lessThanEqual(value, maxRange + tolerance);
    vec4 inRange = vec4(inRangeLower) * vec4(inRangeUpper);

    vec4 range = maxRange - minRange;
    vec4 center = (minRange + maxRange) * 0.5;
    vec4 distance = abs(value - center);
    vec4 normalizedDistance = distance / (range * 0.5 + vec4(0.0001));

    vec4 fit = max(vec4(0.0), vec4(1.0) - normalizedDistance);
    vec4 rangePenalty = vec4(1.0) - min(vec4(0.5), range * 0.5);

    return fit * rangePenalty * inRange;
}

float getOverallFit(float elevation, float moisture, float temperature, float equator,
        float elevMin, float elevMax, float moistMin, float moistMax,
        float tempMin, float tempMax, float eqMin, float eqMax)
{
    vec4 values = vec4(elevation, moisture, temperature, equator);
    vec4 minRanges = vec4(elevMin, moistMin, tempMin, eqMin);
    vec4 maxRanges = vec4(elevMax, moistMax, tempMax, eqMax);

    vec4 fits = getRangeFitVec4(values, minRanges, maxRanges);
    float totalFit = dot(fits, vec4(1.0));

    return (totalFit * 2.0) / 4.0;
}

float randomFromPosition(uint x, uint y, uint z, uint seed)
{
    float scale = 0.5;
    float xOffset = float(seed) * 128.0 + 0.5;
    float yOffset = float(seed) * 256.0 + 0.5;
    float zOffset = float(seed) * 384.0 + 0.5;
    float noise = noise3D(float(x) * scale + xOffset, float(y) * scale + yOffset, float(z) * scale + zOffset);
    return noise * 0.5 + 0.5;
}

void main()
{
    uint localId = gl_LocalInvocationIndex;
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    if (localId < 256) {
        cachedPerm[localId] = perm[localId];
        cachedPermGradIndex3D[localId] = permGradIndex3D[localId];
    }
    uint cacheSize = min(pc.unitRegistryCount, 64u);
    for (uint i = localId; i < cacheSize; i += 256) {
        cachedUnits[i] = units[i];
    }
    cacheSize = min(pc.biomeRegistryCount, 64u);
    for (uint i = localId; i < cacheSize; i += 256) {
        cachedBiomes[i] = biomes[i];
    }
    barrier();

    if (x >= pc.width || y >= pc.height || z >= pc.depth)
    {
        return;
    }

    float normalizedDepth = float(z) / float(pc.depth);
    bool isGround = normalizedDepth < pc.groundLevel;

    float elevation, temperature, moisture;
    if (isGround) {
        float virtualDepth = normalizedDepth / pc.groundLevel; // 0.0 to 1.0 within ground level

        vec4 elevData = imageLoad(basemapElevationImage, ivec2(int(x), int(y)));
        vec4 tempData = imageLoad(basemapTemperatureImage, ivec2(int(x), int(y)));
        vec4 moistData = imageLoad(basemapMoistureImage, ivec2(int(x), int(y)));

        // Higher virtual depth (deeper in ground) = darker values (lower elevation, etc.)
        float depthFactor = 1.0 - virtualDepth; // Surface = 1.0, bottom of ground = 0.0

        elevation = (1.0 - elevData.r) * depthFactor;
        temperature = tempData.r * depthFactor;
        moisture = moistData.r * depthFactor;
    } else {
        vec4 elevData = imageLoad(deepmapElevationImage, ivec3(int(x), int(y), int(z)));
        vec4 tempData = imageLoad(deepmapTemperatureImage, ivec3(int(x), int(y), int(z)));
        vec4 moistData = imageLoad(deepmapMoistureImage, ivec3(int(x), int(y), int(z)));
        elevation = 1.0 - elevData.r;
        temperature = tempData.r;
        moisture = moistData.r;
    }

    vec4 equatorData = imageLoad(equatorImage, ivec2(int(x), int(y)));
    float equator = equatorData.r * 2.0 - 1.0; // Latitude: -1.0 (south pole) to 1.0 (north pole)

    vec3 worldPosition = vec3(float(x), float(y), float(z)) + pc.worldOrigin;
    float randomValue = randomFromPosition(uint(worldPosition.x), uint(worldPosition.y), uint(worldPosition.z), planet.seed);

    uint selectedBiomeId = 0xFFFFFFFF;
    float bestBiomeFit = -1.0;
    BiomeData selectedBiome;

    uint selectedUnitId = pc.airUnitId;
    float bestUnitFit = -1.0;

    uint biomeCount = min(pc.biomeRegistryCount, 256u);
    uint unitCount = min(pc.unitRegistryCount, 256u);

    for (uint i = 0; i < biomeCount; ++i)
    {
        BiomeData biome = cachedBiomes[i];

        float fit = getOverallFit(elevation, moisture, temperature, equator,
                biome.elevationMin, biome.elevationMax,
                biome.moistureMin, biome.moistureMax,
                biome.temperatureMin, biome.temperatureMax,
                biome.equatorMin, biome.equatorMax);

        if (fit > 0.0)
        {
            float finalScore = fit * (0.5 + 0.5 * randomValue);

            if (finalScore > bestBiomeFit)
            {
                bestBiomeFit = finalScore;
                selectedBiomeId = biome.typeId;
                selectedBiome = biome;

                if (bestBiomeFit > 0.925) break;
            }
        }
    }

    imageStore(biomeOutputImage, ivec3(int(x), int(y), int(z)), uvec4(selectedBiomeId, 0, 0, 0));

    float biomeFactor = (bestBiomeFit > 0.0) ? (0.5 + 0.5 * bestBiomeFit) : 0.5;
    float randomFactor = 0.5 + 0.5 * randomValue;

    for (uint i = 0; i < unitCount; ++i)
    {
        UnitData unit = cachedUnits[i];

        if (unit.typeId == pc.airUnitId)
        {
            continue;
        }

        float fit = getOverallFit(elevation, moisture, temperature, equator,
                unit.elevationMin, unit.elevationMax,
                unit.moistureMin, unit.moistureMax,
                unit.temperatureMin, unit.temperatureMax,
                unit.equatorMin, unit.equatorMax);

        if (fit > 0.0)
        {
            float finalScore = fit * biomeFactor * randomFactor;

            if (finalScore > bestUnitFit)
            {
                bestUnitFit = finalScore;
                selectedUnitId = unit.typeId;
                if (bestUnitFit > 0.95) break;
            }
        }
    }

    if (selectedBiomeId != 0xFFFFFFFF && elevation > selectedBiome.elevationMax)
    {
        selectedUnitId = pc.airUnitId;
    }

    imageStore(unitOutputImage, ivec3(int(x), int(y), int(z)), uvec4(selectedUnitId, 0, 0, 0));
}
