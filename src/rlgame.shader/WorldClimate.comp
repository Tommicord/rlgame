#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(push_constant) uniform ClimatePushConstants {
    vec3 worldOrigin;      // Origin of the region to process
    uint width;            // Width of the region in texels
    uint height;           // Height of the region in texels
    float texelSize;       // Size of each texel in world units
    uint _padding[4];
} pc;

layout(rgba8, binding = 0) uniform image2D equatorImage;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.width || y >= pc.height) {
        return;
    }
    float normalizedX = float(x) / float(pc.width);
    float normalizedY = float(y) / float(pc.height);

    // 0.0 = equator (brightest), 1.0 = poles (darkest)
    float distanceFromEquator = abs(normalizedY - 0.5) * 2.0;

    // Brightness: 1.0 at equator, decreasing to 0.5 at poles
    float brightness = 1.0 - (distanceFromEquator * 0.5);

    // Pack into RGBA8
    uint r = uint(clamp(brightness, 0.0, 1.0) * 255.0);
    uint g = uint(clamp(brightness, 0.0, 1.0) * 255.0);
    uint b = uint(clamp(brightness, 0.0, 1.0) * 255.0);
    uint a = 255;

    vec4 packedData = vec4(float(r) / 255.0, float(g) / 255.0, float(b) / 255.0, float(a) / 255.0);
    imageStore(equatorImage, ivec2(int(x), int(y)), packedData);
}
