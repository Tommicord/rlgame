// Shared WorldMeshTess logic for both with and without occlusion culling

struct MappedUnitShapeCurve
{
    uint polyCurvePlanes;
    uint polyCurveRotation;
};

// Full detail unit shape with curved faces
struct MappedUnitShape
{
    MappedUnitShapeCurve top;    // Top face curvature
    MappedUnitShapeCurve down;   // Bottom face curvature
    MappedUnitShapeCurve left;   // Left face curvature
    MappedUnitShapeCurve right;  // Right face curvature
    MappedUnitShapeCurve front;  // Front face curvature
    MappedUnitShapeCurve back;   // Back face curvature

    uint polyCurveLTop;    // Left face top edge
    uint polyCurveRTop;    // Right face top edge
    uint polyCurveLDown;   // Left face bottom edge
    uint polyCurveRDown;   // Right face bottom edge
    uint polyCurveLRight;  // Left face right edge
    uint polyCurveRLeft;   // Right face left edge
    uint polyCurveLLeft;   // Left face left edge
    uint polyCurveRRight;  // Right face right edge

    uint width;   // Unit width
    uint height;  // Unit height
    uint depth;   // Unit depth
};

// Medium detail unit shape with simplified curves
struct MappedUnitShapeMedium
{
    uint polyCurveRotation;  // Shared rotation for all faces
    uint polyCurveHorizontal; // Shared horizontal curvature
    uint polyCurveVertical;   // Shared vertical curvature
    uint width;   // Unit width
    uint height;  // Unit height
    uint depth;   // Unit depth
};

// Low detail unit shape with no curves, basic cubic form
struct MappedUnitShapeLow
{
    uint width;         // Unit width
    uint height;        // Unit height
    uint depth;         // Unit depth
    uint visibleFaces;  // Bitmask of visible faces
};

// LOD Level of detail
// Full = 0, polygonal deformation with detailed curves
// Medium = 1, Simplified curves with reduced precision
// Low = 2, Basic cubic shape without curves
// Culled = 3, Face culling optimization for hidden faces

// Compressed unit shape data (16 bytes total)
struct CompressedUnitShape
{
    uint packedRotations;      // 6 faces × 5 bits = 30 bits for rotation data
    uint packedCurvatures;     // 6 faces × 5 bits = 30 bits for curvature planes
    uint packedEdges;          // 6 edges × 4 bits = 24 bits for edge curves
    uint packedDimensions;     // width (10 bits) | height (10 bits) | depth (10 bits) | padding (2 bits)
};

// Compressed PostUnit struct (32 bytes total for std430 alignment)
struct PostUnit
{
    uint packedFlags;  // lodLevel (8 bits) | flags (8 bits) | reserved (16 bits)
    uint _padding;     // Alignment padding for std430
    CompressedUnitShape shape;
    uint _padding2[2];  // Additional padding to align to 32 bytes
};

// Extract rotation for a specific face (0-5) from packed data
uint getFaceRotation(uint packedRotations, uint faceIndex)
{
    return (packedRotations >> (faceIndex * 5)) & 0x1F;
}

// Extract curvature for a specific face (0-5) from packed data
uint getFaceCurvature(uint packedCurvatures, uint faceIndex)
{
    return (packedCurvatures >> (faceIndex * 5)) & 0x1F;
}

// Extract edge curve for a specific edge (0-5) from packed data
uint getEdgeCurve(uint packedEdges, uint edgeIndex)
{
    return (packedEdges >> (edgeIndex * 4)) & 0x0F;
}

// Extract width from packed dimensions
uint getWidth(uint packedDimensions)
{
    return packedDimensions & 0x3FF;
}

// Extract height from packed dimensions
uint getHeight(uint packedDimensions)
{
    return (packedDimensions >> 10) & 0x3FF;
}

// Extract depth from packed dimensions
uint getDepth(uint packedDimensions)
{
    return (packedDimensions >> 20) & 0x3FF;
}

// Decode rotation from compressed uint
uint getPolyCurveRotationX(uint rotation)
{
    return rotation & 0xFFFF;
}

uint getPolyCurveRotationY(uint rotation)
{
    return (rotation >> 16) & 0xFFFF;
}

// Decode horizontal curvature from compressed uint
uint getPolyCurveHorizontal(uint planes)
{
    return planes & 0xFFFF;
}

// Decode vertical curvature from compressed uint
uint getPolyCurveVertical(uint planes)
{
    return (planes >> 16) & 0xFFFF;
}

// Generate noise-based curvature for a specific face
vec3 generateFaceCurvature(uint unitX, uint unitY, uint unitZ, 
                           uint faceIndex, uint seed, 
                           float noiseScale)
{
    float smallSpace = 0.01;
    float nx = float(unitX) * smallSpace;
    float ny = float(unitY) * smallSpace;
    float nz = float(unitZ) * smallSpace;
    
    float noiseX = noise3D(nx + float(faceIndex) * 0.1, ny, nz + float(seed) * 0.001);
    float noiseY = noise3D(nx, ny + float(faceIndex) * 0.1, nz + float(seed) * 0.001);
    float noiseZ = noise3D(nx + float(seed) * 0.001, ny, nz + float(faceIndex) * 0.1);
    
    noiseX = (noiseX + 1.0) * 0.5;
    noiseY = (noiseY + 1.0) * 0.5;
    noiseZ = (noiseZ + 1.0) * 0.5;
    
    return vec3(noiseX, noiseY, noiseZ);
}

vec3 deformVertex(vec3 basePos, uint unitX, uint unitY, uint unitZ, uint seed)
{
    float smallSpace = 0.02;
    float nx = float(unitX) * smallSpace + basePos.x * 0.1;
    float ny = float(unitY) * smallSpace + basePos.y * 0.1;
    float nz = float(unitZ) * smallSpace + basePos.z * 0.1;
    
    float deformation = fBM3D(nx, ny, nz, 3, 0.5);
    deformation = (deformation + 1.0) * 0.5;
    
    vec3 normal = normalize(basePos - vec3(0.5));
    float deformAmount = 0.15;
    
    return basePos + normal * (deformation - 0.5) * deformAmount;
}

vec3 generateIrregularVertex(uint vertexIndex, uint unitX, uint unitY, uint unitZ, uint seed)
{
    vec3 basePositions[8] = vec3[](
        vec3(0.0, 0.0, 0.0), // 0: bottom-left-back
        vec3(1.0, 0.0, 0.0), // 1: bottom-right-back
        vec3(0.0, 1.0, 0.0), // 2: top-left-back
        vec3(1.0, 1.0, 0.0), // 3: top-right-back
        vec3(0.0, 0.0, 1.0), // 4: bottom-left-front
        vec3(1.0, 0.0, 1.0), // 5: bottom-right-front
        vec3(0.0, 1.0, 1.0), // 6: top-left-front
        vec3(1.0, 1.0, 1.0)  // 7: top-right-front
    );
    
    vec3 basePos = basePositions[vertexIndex % 8];
    basePos = deformVertex(basePos, unitX, unitY, unitZ, seed);
    float vertexNoise = noise3D(
        float(unitX) * 0.05 + float(vertexIndex) * 0.1,
        float(unitY) * 0.05 + float(seed) * 0.001,
        float(unitZ) * 0.05
    );
    float irregularity = 0.1;
    basePos.x += (vertexNoise - 0.5) * irregularity;
    basePos.y += (vertexNoise - 0.5) * irregularity;
    basePos.z += (vertexNoise - 0.5) * irregularity;
    
    return clamp(basePos, vec3(0.0), vec3(1.0));
}

bool processUnitTessellation(uint globalId, uint width, uint height, uint depth, 
                             uint airUnitId, uint seed, 
                             inout PostUnit unit, bool isVisibleFromOcclusion)
{
    uint unitX = globalId % width;
    uint unitY = (globalId / width) % height;
    uint unitZ = globalId / (width * height);

    // Check occlusion culling visibility
    if (!isVisibleFromOcclusion)
    {
        unit.packedFlags = (2 << 0) | (0x00 << 8); // lodLevel=2, flags=0 (not visible)
        unit.shape.packedRotations = 0;
        unit.shape.packedCurvatures = 0;
        unit.shape.packedEdges = 0;
        unit.shape.packedDimensions = 0;
        return false;
    }
    return true;
}

void completeUnitTessellation(uint unitId, uint airUnitId, uint seed, 
                               uint unitX, uint unitY, uint unitZ,
                               inout PostUnit unit)
{
    if (unitId == airUnitId)
    {
        unit.packedFlags = (2 << 0) | (0x00 << 8); // lodLevel=2, flags=0 (not visible)
        unit.shape.packedRotations = 0;
        unit.shape.packedCurvatures = 0;
        unit.shape.packedEdges = 0;
        unit.shape.packedDimensions = 0;
        return;
    }

    unit.packedFlags = (0 << 0) | (0x02 << 8); // lodLevel=0, flags=0x02 (visible)
    
    float noiseScale = 1.0;
    
    // Pack face rotations (6 faces x 5 bits each)
    uint packedRotations = 0;
    for (uint i = 0; i < 6; i++)
    {
        vec3 curvature = generateFaceCurvature(unitX, unitY, unitZ, i, seed, noiseScale);
        uint rotation = uint(curvature.z * 31.0); // 5-bit precision (0-31)
        packedRotations |= (rotation & 0x1F) << (i * 5);
    }
    unit.shape.packedRotations = packedRotations;
    
    // Pack face curvatures (6 faces x 5 bits each)
    uint packedCurvatures = 0;
    for (uint i = 0; i < 6; i++)
    {
        vec3 curvature = generateFaceCurvature(unitX, unitY, unitZ, i, seed, noiseScale);
        uint curvatureValue = uint((curvature.x + curvature.y) * 0.5 * 31.0); // 5-bit precision
        packedCurvatures |= (curvatureValue & 0x1F) << (i * 5);
    }
    unit.shape.packedCurvatures = packedCurvatures;
    
    // Pack edge curves (6 edges x 4 bits each)
    uint packedEdges = 0;
    for (uint i = 0; i < 6; i++)
    {
        vec3 edgeCurve = generateFaceCurvature(unitX, unitY, unitZ, 6 + i, seed, noiseScale);
        uint edgeValue = uint(edgeCurve.x * 15.0); // 4-bit precision (0-15)
        packedEdges |= (edgeValue & 0x0F) << (i * 4);
    }
    unit.shape.packedEdges = packedEdges;
    
    // Pack dimensions (width, height, depth, 10 bits each)
    float sizeNoise = fBM3D(float(unitX) * 0.05, float(unitY) * 0.05, float(unitZ) * 0.05, 2, 0.5);
    sizeNoise = (sizeNoise + 1.0) * 0.5;
    
    uint baseSize = 16;
    uint sizeVariation = uint(sizeNoise * 4.0);
    uint finalSize = baseSize + sizeVariation;
    
    unit.shape.packedDimensions = finalSize | (finalSize << 10) | (finalSize << 20);
}
