#version 460

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

struct PlanetData {
    vec3 center;
    float radius;
    vec3 axis;
    float mass;
    vec3 velocity;
    float gravity;
    float baseTemperature;
    float baseMoisture;
    float atmosphereHeight;
    uint seed;
    uint shapeType;
    uint _padding[2];
};

layout(push_constant) uniform ClimatePushConstants {
    vec3 worldOrigin;      // Origin of the region to process
    uint width;            // Width of the region in texels
    uint height;           // Height of the region in texels
    float texelSize;       // Size of each texel in world units
    uint planetIndex;      // Index of the planet to use
    uint _padding[3];
} pc;

layout(std140, binding = 0) buffer PlanetBuffer {
    PlanetData planet;
};

layout(rgba8, binding = 1) uniform image2D equatorImage;

float calculateLatitude(vec3 worldPos, PlanetData planet) {
    vec3 relativePos = worldPos - planet.center;
    float distance = length(relativePos);
    float nearCenter = 0.0004;

    if (distance < nearCenter) {
        return 0.0; // At center, return equator
    }

    // Normalize to get direction from planet center
    vec3 direction = normalize(relativePos);
    vec3 normalizedAxis = normalize(planet.axis);

    // Latitude is the dot product of direction and the planet's axis
    // This projects the direction onto the rotation axis
    // -1.0 = south pole, 0.0 = equator, 1.0 = north pole
    return dot(direction, normalizedAxis);
}

float calculateEquatorDarkening(float latitude) {
    // Absolute distance from equator
    float distanceFromEquator = abs(latitude);

    // Darken as we move away from equator
    // 1.0 at equator (brightest), 0.5 at poles (darkest)
    // Adjust the multiplier to control darkness intensity
    return 1.0 - (distanceFromEquator * 0.5);
}

float calculateTemperatureModifier(float latitude, float baseTemp) {
    // Temperature decreases as we move away from equator
    float distanceFromEquator = abs(latitude);
    float tempModifier = baseTemp * (1.0 - distanceFromEquator * 0.7);

    // Clamp to valid range
    return clamp(tempModifier, 0.0, 1.0);
}

float calculateMoistureModifier(float latitude, float baseMoisture) {
    // Moisture typically decreases at poles and very near equator (deserts)
    // Peak moisture in temperate zones
    float distanceFromEquator = abs(latitude);
    float moistureModifier;
    float nearEquatorThreshold = 0.4; // Threshold for near equator
    float temperateThreshold = 0.75; // Threshold for temperate zones

    if (distanceFromEquator < nearEquatorThreshold) {
        // Near equator: slightly drier (tropical savannas)
        moistureModifier = baseMoisture * nearEquatorThreshold;
    } else if (distanceFromEquator < temperateThreshold) {
        // Temperate zones: peak moisture
        moistureModifier = baseMoisture;
    } else {
        // Polar regions: very dry
        moistureModifier = baseMoisture * 0.3566;
    }

    return clamp(moistureModifier, 0.0, 1.0);
}

void main() {
    // Calculate 2D position in the region
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    if (x >= pc.width || y >= pc.height) {
        return;
    }
    // Calculate world position (3D for proper latitude calculation)
    vec3 worldPos = pc.worldOrigin +
    vec3(float(x) * pc.texelSize,
            float(y) * pc.texelSize,
            0.0f);
    float latitude = calculateLatitude(worldPos, planet);
    float darkening = calculateEquatorDarkening(latitude);
    float tempMod = calculateTemperatureModifier(latitude, planet.baseTemperature);
    float moistureMod = calculateMoistureModifier(latitude, planet.baseMoisture);

    // Explicitly convert to uint for proper 8-bit quantization
    uint r = uint(clamp(latitude * 0.5 + 0.5, 0.0, 1.0) * 255.0);    // Map -1..1 to 0..1
    uint g = uint(clamp(darkening, 0.0, 1.0) * 255.0);
    uint b = uint(clamp(tempMod, 0.0, 1.0) * 255.0);
    uint a = uint(clamp(moistureMod, 0.0, 1.0) * 255.0);

    vec4 packedData = vec4(float(r) / 255.0, float(g) / 255.0, float(b) / 255.0, float(a) / 255.0);
    imageStore(equatorImage, ivec2(int(x), int(y)), packedData);
}
