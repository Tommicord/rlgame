#version 460

// Unit Mesh Generation Compute Shader
// Generates vertices for unit cubes with proper winding order for VK_FRONT_FACE_CLOCKWISE
// and VK_CULL_MODE_BACK_BIT

layout(local_size_x = 24) in;

struct UnitRenderVertex {
    vec4 position;      // 16 bytes
    vec4 polRight;      // 16 bytes
    vec4 polLeft;       // 16 bytes
    vec2 texCoords;     // 8 bytes
    uint lightingEmit;  // 4 bytes
    uint transparencyLevel; // 4 bytes
    uint faceIndex;     // 4 bytes
    float roughness;     // 4 bytes
    float metallic;     // 4 bytes
    float padding;       // 4 bytes
    vec4 polCurve;      // 16 bytes
    vec4 albedo;        // 16 bytes
    vec4 tangent;       // 16 bytes
    vec4 bitangent;     // 16 bytes
    vec4 normal;        // 16 bytes
    uint unitId;        // 4 bytes
};

layout(std430, binding = 0) buffer VertexBuffer {
    UnitRenderVertex vertices[];
};

struct UnitData {
    uint unitId;
    float temperature;
    float moisture;
    float roughness;
    float metallic;
    float albedoR;
    float albedoG;
    float albedoB;
    float reflectivity;
    float refractiveIndex;
    float dirtiness;
    float hardness;
    float explosionResistance;
    float transparency;
    float emissiveIntensity;
    float subsurfaceScattering;
    float flammability;
    float lightEmit;
    float lightOpacity;
    float ambientOcclusion;
    float lightAbsorption;
    float lightScattering;
    float humidity;
    uint isLiquid;
    uint isGas;
    uint isSolid;
    float padding[3];
};

struct PolFence {
    float t;
    float d;
    float b;
    float f;
};

layout(std430, binding = 1) readonly buffer UnitArray {
    uint unitCount;
    uint padding0;
    uint padding1;
    uint padding2;
    UnitData units[];
} unitArray;

layout(std430, binding = 2) readonly buffer PolFenceArray {
    uint fenceCount;
    uint padding0;
    uint padding1;
    uint padding2;
    PolFence fences[];
} polFenceArray;

layout(push_constant) uniform PushConstants {
    uint unitId;
    uint startVertex;
};

// Face definitions (clockwise winding when viewed from outside)
// Each face has 4 vertices
const vec3 faceVertices[6][4] = {
    // Front face (Z+)
    {vec3(-0.5, -0.5, 0.5), vec3(0.5, -0.5, 0.5), vec3(0.5, 0.5, 0.5), vec3(-0.5, 0.5, 0.5)},
    // Back face (Z-)
    {vec3(0.5, -0.5, -0.5), vec3(-0.5, -0.5, -0.5), vec3(-0.5, 0.5, -0.5), vec3(0.5, 0.5, -0.5)},
    // Top face (Y+)
    {vec3(-0.5, 0.5, 0.5), vec3(0.5, 0.5, 0.5), vec3(0.5, 0.5, -0.5), vec3(-0.5, 0.5, -0.5)},
    // Bottom face (Y-)
    {vec3(-0.5, -0.5, -0.5), vec3(0.5, -0.5, -0.5), vec3(0.5, -0.5, 0.5), vec3(-0.5, -0.5, 0.5)},
    // Right face (X+)
    {vec3(0.5, -0.5, 0.5), vec3(0.5, -0.5, -0.5), vec3(0.5, 0.5, -0.5), vec3(0.5, 0.5, 0.5)},
    // Left face (X-)
    {vec3(-0.5, -0.5, -0.5), vec3(-0.5, -0.5, 0.5), vec3(-0.5, 0.5, 0.5), vec3(-0.5, 0.5, -0.5)}
};

void main() {
    uint globalId = gl_GlobalInvocationID.x;
    uint outputIndex = startVertex + globalId;

    if (outputIndex >= vertices.length()) {
        return;
    }
    
    // Calculate which face and vertex this invocation handles
    uint faceIndex = vertexIndex / 4;
    uint vertexInFace = vertexIndex % 4;
    
    if (faceIndex >= 6) return;
    
    UnitRenderVertex v;

    // Default unit properties if none are found in the unit array
    UnitData unitData;
    unitData.unitId = unitId;
    unitData.roughness = 0.95;
    unitData.metallic = 0.0;
    unitData.albedoR = 0.6;
    unitData.albedoG = 0.4;
    unitData.albedoB = 0.2;
    unitData.transparency = 0.0;
    unitData.lightEmit = 0.0;

    PolFence fence;
    fence.t = 0.0;
    fence.d = 0.0;
    fence.b = 0.0;
    fence.f = 0.0;
    bool foundUnit = false;

    for (uint i = 0u; i < unitArray.unitCount; ++i) {
        if (unitArray.units[i].unitId == unitId) {
            unitData = unitArray.units[i];
            if (i < polFenceArray.fenceCount) {
                fence = polFenceArray.fences[i];
            }
            foundUnit = true;
            break;
        }
    }
    
    // Position
    v.position = vec4(faceVertices[faceIndex][vertexInFace], 1.0);
    
    // Polygon fence data from unit chunk properties
    v.polRight = vec4(fence.t, fence.d, fence.b, fence.f);
    v.polLeft = vec4(fence.t, fence.d, fence.b, fence.f);
    
    // Texture coordinates
    v.texCoords = faceTexCoords[vertexInFace];
    
    // Material properties from the unit array
    v.lightingEmit = uint(clamp(unitData.lightEmit * 255.0, 0.0, 255.0));
    v.transparencyLevel = uint(clamp(unitData.transparency * 255.0, 0.0, 255.0));
    v.faceIndex = faceIndex;
    v.roughness = unitData.roughness;
    v.metallic = unitData.metallic;
    v.padding = 0.0;
    
    // Curvature (zeros for now)
    v.polCurve = vec4(0.0);
    
    // Albedo from the unit array
    v.albedo = vec4(unitData.albedoR, unitData.albedoG, unitData.albedoB, 1.0);
    
    // Tangent, bitangent, normal
    vec3 normal = normalize(faceNormals[faceIndex]);
    vec3 tangent = normalize(faceTangents[faceIndex]);
    vec3 bitangent = normalize(cross(normal, tangent));
    
    v.tangent = vec4(tangent, 0.0);
    v.bitangent = vec4(bitangent, 0.0);
    v.normal = vec4(normal, 0.0);
    
    // Unit ID for array-based rendering
    v.unitId = unitId;
    
    // Write to output buffer at the requested vertex offset
    vertices[outputIndex] = v;
}
