#version 450

// world.noise.comp
// Compute shader that converts a provided 3D array of Simplex noise values
// into three 3D channels: temperature, moisture and elevation.
// - Input:  binding=0, readonly float noise[] (expected range -1..1 or 0..1)
// - Output: binding=1 temperature[], binding=2 moisture[], binding=3 elevation[]
// Push constants configure chunk dimensions and mapping parameters.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer NoiseIn
{
    float noise[];
} inNoise;

layout(std430, binding = 1) writeonly buffer TemperatureOut
{
    float temperature[];
} outTemp;

layout(std430, binding = 2) writeonly buffer MoistureOut
{
    float moisture[];
} outMoist;

layout(std430, binding = 3) writeonly buffer ElevationOut
{
    float elevation[];
} outElev;

layout(push_constant) uniform PC
{
    uint width;     // chunk width (x)
    uint height;    // chunk height (y)
    uint depth;     // chunk depth (z)

    float globalScale;   // optional global scale (not required if noise already sampled)

// Temperature mapping
    float tempBase;      // base temperature (0..1)
    float tempVariation; // multiplier for noise influence (0..1)

// Moisture mapping
    float moistBase;     // base moisture (0..1)
    float moistVariation;// multiplier for noise influence (0..1)

// Elevation mapping
    float elevBase;      // base elevation (0..1)
    float elevVariation; // multiplier for noise influence (0..1)

// reserved for alignment
    float _pad0;
} pc;

// Shared memory cache for noise values
shared float cachedNoise[8][8][9];

// Helper: compute linear index for (x,y,z) in row-major (x + y*W + z*W*H)
uint ComputeIndex(uvec3 id)
{
    return id.x + id.y * pc.width + id.z * (pc.width * pc.height);
}

// Convert incoming noise to normalized [0..1]. Supports both -1..1 and 0..1 inputs.
float NormalizeNoise(float n)
{
    // Heuristic: if values appear to already be in [0,1], keep as-is.
    if (n >= 0.0 && n <= 1.0)
    return n;
    return (n * 0.5) + 0.5;
}

void main()
{
    uvec3 gid = gl_GlobalInvocationID.xyz;
    uvec3 tid = gl_LocalInvocationID.xyz; // Local ID within workgroup (0 to 7)

    bool inBounds = (gid.x < pc.width && gid.y < pc.height && gid.z < pc.depth);
    uint idx = ComputeIndex(gid);

    cachedNoise[tid.x][tid.y][tid.z] = inBounds ? inNoise.noise[idx] : 0.0f;

    memoryBarrierShared();
    barrier();

    // Bounds check: dispatch might be larger than chunk dimensions
    if (!inBounds)
    return;

    // Read from cache
    float rawNoise = cachedNoise[tid.x][tid.y][tid.z];
    float n = NormalizeNoise(rawNoise);

    // Normalize vertical coordinate (height) to [0..1]
    float heightNorm = 0.0;
    if (pc.height > 1u)
    heightNorm = float(gid.y) / float(pc.height - 1u);

    // Simple mapping rules (adjustable via push constants):
    // Elevation: base +/- variation by noise, plus a small vertical bias
    float elev = pc.elevBase + (n - 0.5) * 2.0 * pc.elevVariation;
    elev += (heightNorm - 0.5) * 0.25; // gentle vertical slope
    elev = clamp(elev, 0.0, 1.0);

    // Temperature: base +/- noise influence, decrease with height (colder at higher Y)
    float temp = pc.tempBase + (n - 0.5) * 2.0 * pc.tempVariation;
    temp -= heightNorm * 0.5; // lapse rate-ish effect
    temp = clamp(temp, 0.0, 1.0);

    // Moisture: base +/- noise influence, add simple latitude-like bias in Z
    float lat = 0.0;
    if (pc.depth > 1u)
    {
        // center-based latitude: closer to center -> more moisture
        float zCenter = float(pc.depth - 1u) * 0.5;
        lat = 1.0 - (abs(float(gid.z) - zCenter) / (float(pc.depth) * 0.5));
        lat = clamp(lat, 0.0, 1.0);
    }

    float moist = pc.moistBase + (n - 0.5) * 2.0 * pc.moistVariation;
    moist = mix(moist, moist + 0.15 * lat, 0.5);
    moist = clamp(moist, 0.0, 1.0);

    // Write outputs
    outElev.elevation[idx] = elev;
    outTemp.temperature[idx] = temp;
    outMoist.moisture[idx] = moist;
}
