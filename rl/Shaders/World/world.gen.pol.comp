#version 450

// Compute shader that generates polygon fence values for smooth curved terrain
// - Input:  binding=0, readonly uint unitIds[] (from world.unitplace.comp)
// - Input:  binding=1, readonly buffer UnitTransparencyLUT (float lookup table)
// - Input:  binding=2, readonly buffer NonCurableLUT (uint lookup table)
// - Output: binding=3, writeonly buffer PolFenceOut (float array: t, d, b, f per voxel)
// Push constants configure chunk dimensions and air unit ID

layout(local_size_x = 8, local_size_y = 1, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer UnitIdsIn
{
    uint unitIds[];
} inUnits;

layout(std430, binding = 1) readonly buffer UnitTransparencyLUT
{
    float transparencies[]; // (1 = transparent, 0 = no transparency)
} unitLookup;

layout(std430, binding = 2) readonly buffer NonCurableLUT
{
    uint isCurable[]; // (1 = curable, 0 = not curable)
} curableLookup;

layout(std430, binding = 3) writeonly buffer PolFenceOut
{
    vec4 polFence[]; // vec4 per voxel: (t, d, b, f)
} outPolFence;

layout(push_constant) uniform PC
{
    uint width;     // chunk width (x)
    uint height;    // total chunk height (y)
    uint depth;     // chunk depth (z)
    uint airUnitId; // air unit ID to skip
    float curveStrength; // strength of curvature (0.0 = flat, 1.0 = maximum curve)
    uint maxUnitId; // Maximum unit ID for lookup table bounds checking
    uint yOffset;   // Y offset for this slice (for sub-dispatch)
    uint sliceHeight; // Height of this slice (for sub-dispatch)
} pc;

// Shared memory cache for unit IDs with 1-block border
shared uint localUnitCache[10][3][10];

uint ComputeIndex(uvec3 id) {
    uint globalY = id.y + pc.yOffset;
    return id.x + globalY * pc.width + id.z * (pc.width * pc.height);
}

uint GetUnitIdSafe(int x, int y, int z) {
    int globalY = y + int(pc.yOffset);
    if (x < 0 || x >= int(pc.width) || globalY < 0 || globalY >= int(pc.height) || z < 0 || z >= int(pc.depth)) {
        return pc.airUnitId;
    }
    return inUnits.unitIds[x + globalY * int(pc.width) + z * int(pc.width * pc.height)];
}

void main()
{
    uvec3 gid = gl_GlobalInvocationID.xyz;
    uvec3 tid = gl_LocalInvocationID.xyz;

    int lx = int(tid.x) + 1;
    int ly = int(tid.y) + 1;
    int lz = int(tid.z) + 1;

    int gx = int(gid.x);
    int gy = int(gid.y);
    int gz = int(gid.z);

    bool insideBounds = (gx < int(pc.width) && (gy + int(pc.yOffset)) < int(pc.height) && gz < int(pc.depth));

    localUnitCache[lx][ly][lz] = insideBounds ? inUnits.unitIds[ComputeIndex(gid)] : pc.airUnitId;

    // Edge loading for 8x1x8 workgroup
    if (tid.x == 0) localUnitCache[0][ly][lz] = GetUnitIdSafe(gx - 1, gy, gz);
    if (tid.x == 7) localUnitCache[9][ly][lz] = GetUnitIdSafe(gx + 1, gy, gz);
    if (tid.z == 0) localUnitCache[lx][ly][0] = GetUnitIdSafe(gx, gy, gz - 1);
    if (tid.z == 7) localUnitCache[lx][ly][9] = GetUnitIdSafe(gx, gy, gz + 1);

    localUnitCache[lx][0][lz] = GetUnitIdSafe(gx, gy - 1, gz);
    localUnitCache[lx][2][lz] = GetUnitIdSafe(gx, gy + 1, gz);

    memoryBarrierShared();
    barrier();

    if (insideBounds)
    {
        uint voxelIdx = ComputeIndex(gid);
        uint currentUnit = localUnitCache[lx][ly][lz];

        if (currentUnit >= pc.maxUnitId || currentUnit == pc.airUnitId)
        {
            outPolFence.polFence[voxelIdx] = vec4(0.0f);
            return;
        }
        if (unitLookup.transparencies[currentUnit] > 0.5f || curableLookup.isCurable[currentUnit] == 0)
        {
            outPolFence.polFence[voxelIdx] = vec4(0.0f);
            return;
        }

        uint uTop = localUnitCache[lx][ly + 1][lz];
        uint uDown = localUnitCache[lx][ly - 1][lz];
        uint uBack = localUnitCache[lx][ly][lz - 1];
        uint uFront = localUnitCache[lx][ly][lz + 1];

        float t = (currentUnit != uTop && uTop != pc.airUnitId && unitLookup.transparencies[uTop] <= 0.5f && curableLookup.isCurable[uTop] != 0) ? clamp(-1.0f * pc.curveStrength, -1.0f, 1.0f) : 0.0f;
        float d = (currentUnit != uDown && uDown != pc.airUnitId && unitLookup.transparencies[uDown] <= 0.5f && curableLookup.isCurable[uDown] != 0) ? clamp(1.0f * pc.curveStrength, -1.0f, 1.0f) : 0.0f;
        float b = (currentUnit != uBack && uBack != pc.airUnitId && unitLookup.transparencies[uBack] <= 0.5f && curableLookup.isCurable[uBack] != 0) ? clamp(-1.0f * pc.curveStrength, -1.0f, 1.0f) : 0.0f;
        float f = (currentUnit != uFront && uFront != pc.airUnitId && unitLookup.transparencies[uFront] <= 0.5f && curableLookup.isCurable[uFront] != 0) ? clamp(1.0f * pc.curveStrength, -1.0f, 1.0f) : 0.0f;

        outPolFence.polFence[voxelIdx] = vec4(t, d, b, f);
    }
}