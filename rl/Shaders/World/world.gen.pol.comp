#version 450

// world.gen.pol.comp
// Compute shader that generates polygon fence values for smooth curved terrain
// - Input:  binding=0, readonly uint unitIds[] (from world.unitplace.comp)
// - Input:  binding=1, readonly buffer UnitRegistry (UnitGPUParams[])
// - Input:  binding=2, readonly buffer NonCurableUnits (uint array of unit IDs that cannot be curved)
// - Output: binding=3, writeonly buffer PolFenceOut (float array: t, d, b, f per voxel)
// Push constants configure chunk dimensions and air unit ID

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer UnitIdsIn
{
  uint unitIds[];
} inUnits;

layout(std430, binding = 1) readonly buffer UnitRegistry
{
  uint unitCount;
  uint padding0;
  uint padding1;
  uint padding2;
  float units[];
} unitReg;

layout(std430, binding = 2) readonly buffer NonCurableUnits
{
  uint nonCurableCount;
  uint padding0;
  uint padding1;
  uint padding2;
  uint nonCurableIds[];
} nonCurable;

layout(std430, binding = 3) writeonly buffer PolFenceOut
{
  float polFence[]; // 4 floats per voxel: t, d, b, f
} outPolFence;

layout(push_constant) uniform PC
{
  uint width;     // chunk width (x)
  uint height;    // chunk height (y)
  uint depth;     // chunk depth (z)
  uint airUnitId; // air unit ID to skip
  float curveStrength; // strength of curvature (0.0 = flat, 1.0 = maximum curve)
  float _pad0;
  float _pad1;
  float _pad2;
} pc;

// Helper: compute linear index for (x,y,z) in row-major (x + y*W + z*W*H)
uint ComputeIndex(uvec3 id)
{
  return id.x + id.y * pc.width + id.z * (pc.width * pc.height);
}

// Helper: compute output index for 4 floats per voxel
uint ComputePolFenceIndex(uvec3 id)
{
  return ComputeIndex(id) * 4u;
}

// Get unit transparency from registry
float GetUnitTransparency(uint unitId)
{
  for (uint i = 0; i < unitReg.unitCount; ++i)
  {
    uint regUnitId = uint(unitReg.units[i * 28u + 0u]); // unitId at offset 0
    if (regUnitId == unitId)
    {
      return unitReg.units[i * 28u + 17u]; // transparency at offset 17
    }
  }
  return 0.0f; // Default to opaque
}

// Check if unit can be curved
bool IsUnitCurable(uint unitId)
{
  // Check if unit is in non-curable list
  for (uint i = 0; i < nonCurable.nonCurableCount; ++i)
  {
    if (nonCurable.nonCurableIds[i] == unitId)
      return false;
  }
  return true;
}

// Get unit ID at position with bounds checking
uint GetUnitId(int x, int y, int z)
{
  if (x < 0 || x >= int(pc.width) ||
      y < 0 || y >= int(pc.height) ||
      z < 0 || z >= int(pc.depth))
  {
    return pc.airUnitId; // Return air for out of bounds
  }
  return inUnits.unitIds[ComputeIndex(uvec3(x, y, z))];
}

// Calculate polygon fence value based on neighbor heights
float CalculateFenceValue(int x, int y, int z, int dx, int dy, int dz)
{
  uint currentUnit = GetUnitId(x, y, z);
  uint neighborUnit = GetUnitId(x + dx, y + dy, z + dz);
  
  // Skip if current or neighbor is air
  float currentTrans = GetUnitTransparency(currentUnit);
  float neighborTrans = GetUnitTransparency(neighborUnit);
  
  if (currentTrans > 0.5f || neighborTrans > 0.5f)
    return 0.0f;
  
  // Skip if either unit cannot be curved
  if (!IsUnitCurable(currentUnit) || !IsUnitCurable(neighborUnit))
    return 0.0f;
  
  // Calculate height difference for curvature
  // Positive value means current is higher than neighbor
  float heightDiff = float(y) - float(y + dy);
  
  // Apply curve strength and smoothstep for smooth transitions
  float curve = heightDiff * pc.curveStrength;
  curve = clamp(curve, -1.0f, 1.0f);
  curve = smoothstep(-0.5f, 0.5f, curve);
  
  return curve;
}

void main()
{
  uvec3 gid = gl_GlobalInvocationID.xyz;

  // Bounds check: dispatch might be larger than chunk dimensions
  if (gid.x >= pc.width || gid.y >= pc.height || gid.z >= pc.depth)
    return;

  uint idx = ComputePolFenceIndex(gid);
  uint currentUnit = inUnits.unitIds[ComputeIndex(gid)];

  // Skip air blocks
  if (currentUnit == pc.airUnitId || GetUnitTransparency(currentUnit) > 0.5f)
  {
    outPolFence.polFence[idx + 0u] = 0.0f; // t
    outPolFence.polFence[idx + 1u] = 0.0f; // d
    outPolFence.polFence[idx + 2u] = 0.0f; // b
    outPolFence.polFence[idx + 3u] = 0.0f; // f
    return;
  }

  // Skip if unit cannot be curved
  if (!IsUnitCurable(currentUnit))
  {
    outPolFence.polFence[idx + 0u] = 0.0f; // t
    outPolFence.polFence[idx + 1u] = 0.0f; // d
    outPolFence.polFence[idx + 2u] = 0.0f; // b
    outPolFence.polFence[idx + 3u] = 0.0f; // f
    return;
  }

  // Calculate fence values for each direction
  // T (Top): check neighbor above (+Y)
  float t = CalculateFenceValue(int(gid.x), int(gid.y), int(gid.z), 0, 1, 0);
  
  // D (Down): check neighbor below (-Y)
  float d = CalculateFenceValue(int(gid.x), int(gid.y), int(gid.z), 0, -1, 0);
  
  // B (Back): check neighbor behind (-Z)
  float b = CalculateFenceValue(int(gid.x), int(gid.y), int(gid.z), 0, 0, -1);
  
  // F (Front): check neighbor in front (+Z)
  float f = CalculateFenceValue(int(gid.x), int(gid.y), int(gid.z), 0, 0, 1);

  // Apply additional smoothing by averaging with horizontal neighbors
  // This creates more consistent curves across surfaces
  float tSmooth = t;
  float dSmooth = d;
  float bSmooth = b;
  float fSmooth = f;

  // Sample neighbors for smoothing
  uint leftUnit = GetUnitId(int(gid.x) - 1, int(gid.y), int(gid.z));
  uint rightUnit = GetUnitId(int(gid.x) + 1, int(gid.y), int(gid.z));
  
  if (leftUnit == currentUnit && rightUnit == currentUnit)
  {
    // Horizontal smoothing
    tSmooth = (t + CalculateFenceValue(int(gid.x) - 1, int(gid.y), int(gid.z), 0, 1, 0) +
               CalculateFenceValue(int(gid.x) + 1, int(gid.y), int(gid.z), 0, 1, 0)) / 3.0;
    dSmooth = (d + CalculateFenceValue(int(gid.x) - 1, int(gid.y), int(gid.z), 0, -1, 0) +
               CalculateFenceValue(int(gid.x) + 1, int(gid.y), int(gid.z), 0, -1, 0)) / 3.0;
    bSmooth = (b + CalculateFenceValue(int(gid.x) - 1, int(gid.y), int(gid.z), 0, 0, -1) +
               CalculateFenceValue(int(gid.x) + 1, int(gid.y), int(gid.z), 0, 0, -1)) / 3.0;
    fSmooth = (f + CalculateFenceValue(int(gid.x) - 1, int(gid.y), int(gid.z), 0, 0, 1) +
               CalculateFenceValue(int(gid.x) + 1, int(gid.y), int(gid.z), 0, 0, 1)) / 3.0;
  }

  // Output polygon fence values
  outPolFence.polFence[idx + 0u] = tSmooth; // Top
  outPolFence.polFence[idx + 1u] = dSmooth; // Down
  outPolFence.polFence[idx + 2u] = bSmooth; // Back
  outPolFence.polFence[idx + 3u] = fSmooth; // Front
}