#version 450

// world.unitplace.comp
// Compute shader that places units based on biome classification and unit rules
// - Input:  binding=0, readonly uint biomeIds[]
// - Input:  binding=1, readonly float temperature[]
// - Input:  binding=2, readonly float moisture[]
// - Input:  binding=3, readonly float elevation[]
// - Input:  binding=4, readonly float heightmap[]
// - Input:  binding=5, readonly buffer UnitRegistry (UnitGPUParams[])
// - Input:  binding=6, readonly buffer BiomeUnitRules (BiomeUnitRuleGPU[])
// - Output: binding=7, writeonly uint unitIds[]

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly buffer BiomeIn
{
  uint biomeIds[];
} inBiome;

layout(std430, binding = 1) readonly buffer TempIn
{
  float temperature[];
} inTemp;

layout(std430, binding = 2) readonly buffer MoistIn
{
  float moisture[];
} inMoist;

layout(std430, binding = 3) readonly buffer ElevIn
{
  float elevation[];
} inElev;

layout(std430, binding = 4) readonly buffer HeightmapIn
{
  float heightmap[];
} inHeight;

layout(std430, binding = 5) readonly buffer UnitRegistry
{
  uint unitCount;
  uint padding0;
  uint padding1;
  uint padding2;
  
  // UnitGPUParams structure (aligned to 16 bytes)
  // Packed float array for all unit properties
  float units[];
} unitReg;

layout(std430, binding = 6) readonly buffer BiomeUnitRules
{
  uint ruleCount;
  uint padding0;
  uint padding1;
  uint padding2;
  
  // BiomeUnitRuleGPU structure (aligned to 16 bytes)
  // uint32_t unitId;
  // float minHeight, maxHeight;
  // float minTemperature, maxTemperature;
  // float minMoisture, maxMoisture;
  // float minElevation, maxElevation;
  // float probability, density;
  // float padding[2];
  float rules[];
} biomeRules;

layout(std430, binding = 7) writeonly buffer UnitOut
{
  uint unitIds[];
} outUnit;

layout(push_constant) uniform PC
{
  uint width;     // chunk width (x)
  uint height;    // chunk height (y)
  uint depth;     // chunk depth (z)
  float seaLevel; // sea level threshold
  uint airUnitId; // default unit ID for air
  uint padding1;
  uint padding2;
} pc;

// Helper: compute linear index for (x,y,z) in row-major (x + y*W + z*W*H)
uint ComputeIndex(uvec3 id)
{
  return id.x + id.y * pc.width + id.z * (pc.width * pc.height);
}

// Simple hash function for probabilistic placement
float Hash3D(uint x, uint y, uint z)
{
  uint seed = (x * 374761393u + y * 668265263u + z * 2504567u) ^ 2984356u;
  seed = (seed ^ (seed >> 13u)) * 1274126177u;
  return float(seed & 0x7FFFFFFFu) / float(0x7FFFFFFF);
}

// Get unit rule parameter from packed array
float GetRuleParam(uint ruleIndex, uint paramOffset)
{
  uint baseIndex = ruleIndex * 12u + paramOffset; // 12 floats per rule
  return biomeRules.rules[baseIndex];
}

// Get unit parameter from packed array
float GetUnitParam(uint unitIndex, uint paramOffset)
{
  uint baseIndex = unitIndex * 28u + paramOffset; // 28 floats per unit
  return unitReg.units[baseIndex];
}

void main()
{
  uvec3 gid = gl_GlobalInvocationID.xyz;

  // Bounds check: dispatch might be larger than chunk dimensions
  if (gid.x >= pc.width || gid.y >= pc.height || gid.z >= pc.depth)
    return;

  uint idx = ComputeIndex(gid);
  uint biomeId = inBiome.biomeIds[idx];
  float temp = inTemp.temperature[idx];
  float moist = inMoist.moisture[idx];
  float elev = inElev.elevation[idx];
  float height = inHeight.heightmap[idx];

  // Default to air
  uint selectedUnit = pc.airUnitId;

  // Check if below terrain surface
  if (float(gid.y) < height)
  {
    // Underground - select based on temperature
    // Deeper = hotter, so find unit with highest temperature
    float depth = height - float(gid.y);
    float targetTemperature = depth * 50.0; // Temperature increases with depth
    
    uint hottestUnit = pc.airUnitId;
    float maxTemperature = -1000.0;
    
    // Find unit with temperature closest to target
    for (uint i = 0; i < unitReg.unitCount; ++i)
    {
      uint unitId = uint(GetUnitParam(i, 0));
      float unitTemp = GetUnitParam(i, 1); // Temperature is at offset 1
      
      // Prefer hotter units for deeper locations
      if (unitTemp > maxTemperature)
      {
        maxTemperature = unitTemp;
        hottestUnit = unitId;
      }
    }
    
    // Select unit based on depth temperature gradient
    // Starts as 35KM
    if (depth > 35000.0)
    {
      // Very deep: use hottest unit available
      selectedUnit = hottestUnit;
    }
    else if (depth > 4000.0) // 4 KM
    {
      // Medium depth: find unit with medium-high temperature
      float bestMatch = 1000.0;
      for (uint i = 0; i < unitReg.unitCount; ++i)
      {
        uint unitId = uint(GetUnitParam(i, 0));
        float unitTemp = GetUnitParam(i, 1);
        float tempDiff = abs(unitTemp - 400.0); // Target ~400°C for medium depth
        
        if (tempDiff < bestMatch)
        {
          bestMatch = tempDiff;
          selectedUnit = unitId;
        }
      }
    }
    else
    {
      // Near surface underground: find unit with moderate temperature
      float bestMatch = 1000.0;
      for (uint i = 0; i < unitReg.unitCount; ++i)
      {
        uint unitId = uint(GetUnitParam(i, 0));
        float unitTemp = GetUnitParam(i, 1);
        float tempDiff = abs(unitTemp - 100.0); // Target ~100°C for near surface
        
        if (tempDiff < bestMatch)
        {
          bestMatch = tempDiff;
          selectedUnit = unitId;
        }
      }
    }
  }
  else if (abs(float(gid.y) - height) < 1.0)
  {
    // Surface layer: apply biome rules
    for (uint i = 0; i < biomeRules.ruleCount; ++i)
    {
      uint ruleBiomeId = uint(GetRuleParam(i, 0));
      if (ruleBiomeId != biomeId)
        continue;

      uint ruleUnitId = uint(GetRuleParam(i, 1));
      float minHeight = GetRuleParam(i, 2);
      float maxHeight = GetRuleParam(i, 3);
      float minTemp = GetRuleParam(i, 4);
      float maxTemp = GetRuleParam(i, 5);
      float minMoist = GetRuleParam(i, 6);
      float maxMoist = GetRuleParam(i, 7);
      float minElev = GetRuleParam(i, 8);
      float maxElev = GetRuleParam(i, 9);
      float probability = GetRuleParam(i, 10);
      float density = GetRuleParam(i, 11);

      // Check if rule conditions match
      bool heightMatch = (height >= minHeight) && (height <= maxHeight);
      bool tempMatch = (temp >= minTemp) && (temp <= maxTemp);
      bool moistMatch = (moist >= minMoist) && (moist <= maxMoist);
      bool elevMatch = (elev >= minElev) && (elev <= maxElev);

      if (heightMatch && tempMatch && moistMatch && elevMatch)
      {
        // Probabilistic placement using hash
        float hash = Hash3D(gid.x, gid.y, gid.z);
        if (hash < probability * density)
        {
          selectedUnit = ruleUnitId;
          break;
        }
      }
    }
  }

  outUnit.unitIds[idx] = selectedUnit;
}
