#version 450

layout(local_size_x = 24) in;

struct UnitRenderVertex {
    vec4 position;      // 16 bytes
    vec4 polRight;      // 16 bytes
    vec4 polLeft;       // 16 bytes
    vec2 texCoords;     // 8 bytes
    uint lightingEmit;  // 4 bytes
    uint transparencyLevel; // 4 bytes
    uint faceIndex;     // 4 bytes
    float roughness;     // 4 bytes
    float metallic;     // 4 bytes
    float padding;       // 4 bytes
    vec4 polCurve;      // 16 bytes
    vec4 albedo;        // 16 bytes
    vec4 tangent;       // 16 bytes
    vec4 bitangent;     // 16 bytes
    vec4 normal;        // 16 bytes
    uint unitId;        // 4 bytes
};

layout(std430, binding = 0) buffer VertexBuffer {
    UnitRenderVertex vertices[];
};

struct UnitData {
    vec4 polCurve;
    vec4 polLeft;
    vec4 polRight;
    uint unitId;
    float temperature;
    float moisture;
    float roughness;
    float metallic;
    float albedoR;
    float albedoG;
    float albedoB;
    float reflectivity;
    float refractiveIndex;
    float dirtiness;
    float hardness;
    float explosionResistance;
    float transparency;
    float emissiveIntensity;
    float subsurfaceScattering;
    float flammability;
    float lightEmit;
    float lightOpacity;
    float ambientOcclusion;
    float lightAbsorption;
    float lightScattering;
    float humidity;
    uint isLiquid;
    uint isGas;
    uint isSolid;
    uint padFinal;
};
// Shared memory cache for unit data to avoid repeated global memory access
shared UnitData cachedUnitData[1];

struct PolFence {
    float t;
    float d;
    float b;
    float f;
};

layout(std430, binding = 1) readonly buffer UnitArray {
    uint unitCount;
    uint padding0;
    uint padding1;
    uint padding2;
    UnitData units[];
} unitArray;

layout(std430, binding = 2) readonly buffer PolFenceArray {
    uint fenceCount;
    uint padding0;
    uint padding1;
    uint padding2;
    PolFence fences[];
} polFenceArray;

layout(push_constant) uniform PushConstants {
    uint unitId;
    uint startVertex;
};

const vec3 faceNormals[6] = {
vec3(0, 0, 1),   // Front
vec3(0, 0, -1),  // Back
vec3(0, 1, 0),   // Top
vec3(0, -1, 0),  // Bottom
vec3(1, 0, 0),   // Right
vec3(-1, 0, 0)   // Left
};

const vec2 faceTexCoords[4] = {
vec2(0.0, 0.0),
vec2(1.0, 0.0),
vec2(1.0, 1.0),
vec2(0.0, 1.0)
};

// Tangent calculation (assuming standard UV mapping)
const vec3 faceTangents[6] = {
vec3(1, 0, 0),   // Front
vec3(-1, 0, 0),  // Back
vec3(1, 0, 0),   // Top
vec3(1, 0, 0),   // Bottom
vec3(0, 0, -1),  // Right
vec3(0, 0, 1)    // Left
};

void main() {
    uint globalId = gl_GlobalInvocationID.x;
    uint localId = gl_LocalInvocationIndex;
    uint localIndex = globalId; // 0..23 expected
    uint outputIndex = startVertex + localIndex;

    // Thread 0 loads unit data into shared memory cache
    if (localId == 0) {
        bool foundUnit = false;
        for (uint i = 0u; i < unitArray.unitCount; ++i) {
            if (unitArray.units[i].unitId == unitId) {
                cachedUnitData[0] = unitArray.units[i];
                foundUnit = true;
                break;
            }
        }
        if (!foundUnit) {
            cachedUnitData[0].unitId = 0; // Mark as not found
        }
    }
    memoryBarrierShared();
    barrier();

    // Check if unit was found
    if (cachedUnitData[0].unitId == 0 && unitId != 0) {
        return;
    }

    // Require unit and fence data present; do not use fixed fallback
    if (unitArray.unitCount == 0u || polFenceArray.fenceCount == 0u) {
        return;
    }

    if (outputIndex >= vertices.length()) {
        return;
    }

    // Calculate which face and vertex this invocation handles (4 vertices per face)
    uint faceIndex = localIndex / 4u;
    uint vertexInFace = localIndex % 4u;

    if (faceIndex >= 6u) return;

    UnitRenderVertex v;

    // Use cached unit data from shared memory
    UnitData unitData = cachedUnitData[0];

    // Find the fence data by unitId (separate lookup)
    PolFence fence;
    bool foundFence = false;
    for (uint i = 0u; i < polFenceArray.fenceCount; ++i) {
        if (i < unitArray.unitCount && unitArray.units[i].unitId == unitId) {
            fence = polFenceArray.fences[i];
            foundFence = true;
            break;
        }
    }

    // If fence not found, use default zero fence
    if (!foundFence) {
        fence = PolFence(0.0, 0.0, 0.0, 0.0);
    }

    vec3 pos;
    if (faceIndex == 0u) { // Front
        pos.x = (vertexInFace == 0u || vertexInFace == 3u) ? -0.5 : 0.5;
        pos.y = (vertexInFace == 0u || vertexInFace == 1u) ? -0.5 : 0.5;
        pos.z = 0.5;
    } else if (faceIndex == 1u) { // Back
        pos.x = (vertexInFace == 0u || vertexInFace == 3u) ? 0.5 : -0.5;
        pos.y = (vertexInFace == 0u || vertexInFace == 1u) ? -0.5 : 0.5;
        pos.z = -0.5;
    } else if (faceIndex == 2u) { // Top
        pos.x = (vertexInFace == 0u || vertexInFace == 3u) ? -0.5 : 0.5;
        pos.y = 0.5;
        pos.z = (vertexInFace == 0u || vertexInFace == 1u) ? 0.5 : -0.5;
    } else if (faceIndex == 3u) { // Bottom
        pos.x = (vertexInFace == 0u || vertexInFace == 3u) ? -0.5 : 0.5;
        pos.y = -0.5;
        pos.z = (vertexInFace == 0u || vertexInFace == 1u) ? -0.5 : 0.5;
    } else if (faceIndex == 4u) { // Right
        pos.x = 0.5;
        pos.y = (vertexInFace == 0u || vertexInFace == 1u) ? -0.5 : 0.5;
        pos.z = (vertexInFace == 0u || vertexInFace == 3u) ? 0.5 : -0.5;
    } else { // Left (5)
        pos.x = -0.5;
        pos.y = (vertexInFace == 0u || vertexInFace == 1u) ? -0.5 : 0.5;
        pos.z = (vertexInFace == 0u || vertexInFace == 3u) ? -0.5 : 0.5;
    }

    if (faceIndex == 2u) {
        pos.y += fence.t;
    } else if (faceIndex == 3u) {
        pos.y += fence.d;
    }
    // Left/Right affect X
    if (faceIndex == 5u) {
        pos.x += fence.b;
    } else if (faceIndex == 4u) {
        pos.x += fence.f;
    }
    // Front/Back affect Z
    if (faceIndex == 0u) {
        pos.z += fence.f;
    } else if (faceIndex == 1u) {
        pos.z += fence.b;
    }

    v.position = vec4(pos, 1.0);

    // Polygon fence data from unit chunk properties
    v.polRight = unitData.polRight;
    v.polLeft = unitData.polLeft;

    // Texture coordinates
    v.texCoords = faceTexCoords[vertexInFace];

    // Material properties from the unit array
    v.lightingEmit = uint(unitData.lightEmit * 255.0);
    v.transparencyLevel = uint(unitData.transparency * 255.0);
    v.faceIndex = faceIndex;
    v.roughness = unitData.roughness;
    v.metallic = unitData.metallic;
    v.padding = 0.0;
    v.polCurve = unitData.polCurve;

    // Albedo from the unit array
    v.albedo = vec4(unitData.albedoR, unitData.albedoG, unitData.albedoB, 1.0);

    // Tangent, bitangent, normal
    vec3 normal = normalize(faceNormals[faceIndex]);
    vec3 tangent = normalize(faceTangents[faceIndex]);
    vec3 bitangent = normalize(cross(normal, tangent));

    v.tangent = vec4(tangent, 0.0);
    v.bitangent = vec4(bitangent, 0.0);
    v.normal = vec4(normal, 0.0);

    // Unit ID for array-based rendering
    v.unitId = unitId;

    // Write to output buffer at the requested vertex offset
    vertices[outputIndex] = v;
}