#version 450

layout (local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

shared int cachedPerm[256];
shared int cachedPermGradIndex3D[256];

layout(std430, binding = 0) buffer PermutationBuffer {
    int perm[256];
};

layout(std430, binding = 1) buffer PermGradIndex3DBuffer {
    int permGradIndex3D[256];
};

layout(std430, binding = 2) buffer NoiseBuffer {
    float noiseValues[];
};

int GetPerm(int index) {
    return cachedPerm[index & 255];
}

int GetPermGradIndex3D(int index) {
    return cachedPermGradIndex3D[index & 255];
}

const int GRADIENTS_2D[16] = int[](
        5, 2,    // Gradient 0
        2, 5,    // Gradient 1
        -5, 2,   // Gradient 2
        -2, 5,   // Gradient 3
        5, -2,   // Gradient 4
        2, -5,   // Gradient 5
        -5, -2,  // Gradient 6
        -2, -5   // Gradient 7
);

const int GRADIENTS_3D[72] = int[](
        -11, 4, 4,    // Gradient 0
        -4, 11, 4,    // Gradient 1
        -4, 4, 11,    // Gradient 2
        11, 4, 4,     // Gradient 3
        4, 11, 4,     // Gradient 4
        4, 4, 11,     // Gradient 5
        -11, -4, 4,   // Gradient 6
        -4, -11, 4,   // Gradient 7
        -4, -4, 11,   // Gradient 8
        11, -4, 4,    // Gradient 9
        4, -11, 4,    // Gradient 10
        4, -4, 11,    // Gradient 11
        -11, 4, -4,   // Gradient 12
        -4, 11, -4,   // Gradient 13
        -4, 4, -11,   // Gradient 14
        11, 4, -4,    // Gradient 15
        4, 11, -4,    // Gradient 16
        4, 4, -11,    // Gradient 17
        -11, -4, -4,  // Gradient 18
        -4, -11, -4,  // Gradient 19
        -4, -4, -11,  // Gradient 20
        11, -4, -4,   // Gradient 21
        4, -11, -4,   // Gradient 22
        4, -4, -11    // Gradient 23
);

float Extrapolate2d(int xsb, int ysb, float dx, float dy) {
    int permIndex = GetPerm(xsb + GetPerm(ysb));
    int gradIndex = permIndex & 7;
    int gi = gradIndex * 2;
    float gradX = float(GRADIENTS_2D[gi]);
    float gradY = float(GRADIENTS_2D[gi + 1]);
    return gradX * dx + gradY * dy;
}

float Extrapolate3d(int xsb, int ysb, int zsb, float dx, float dy, float dz) {
    int permIndex = GetPerm(xsb + GetPerm(ysb + GetPerm(zsb)));
    int gradIndex = GetPermGradIndex3D(permIndex);
    int gi = gradIndex;
    float gradX = float(GRADIENTS_3D[gi]);
    float gradY = float(GRADIENTS_3D[gi + 1]);
    float gradZ = float(GRADIENTS_3D[gi + 2]);
    return gradX * dx + gradY * dy + gradZ * dz;
}

#include "simplex.noise.constants.glsl"
#include "simplex.noise2d.glsl"
#include "simplex.noise3d.glsl"
#include "simplex.octaves.glsl"

// Noise generation parameters
layout(std430, push_constant) uniform PushConstants {
    uint dimension;      // 2 or 3
    float scale;         // Noise scale
    float offsetX;       // X offset
    float offsetY;       // Y offset
    float offsetZ;       // Z offset
    uint width;          // Grid width
    uint height;         // Grid height
    uint depth;          // Grid depth
    uint time;           // Time offset for animated noise
    uint octaves;        // Number of octaves for FBM (default: 1)
    float persistence;   // Amplitude multiplier per octave (default: 0.5)
    float lacunarity;    // Frequency multiplier per octave (default: 2.0)
    uint noiseType;      // 0: Standard, 1: FBM, 2: Ridged, 3: Turbulence
    uint seed;           // Seed for permutation initialization
} pc;

void main() {
    uint localId = gl_LocalInvocationIndex;
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    // Load permutation tables into shared memory
    if (localId < 256) {
        cachedPerm[localId] = perm[localId];
        cachedPermGradIndex3D[localId] = permGradIndex3D[localId];
    }
    barrier();
    
    if (x >= pc.width || y >= pc.height || z >= pc.depth) {
        return;
    }

    float worldX = (float(x) / float(pc.width)) * pc.scale + pc.offsetX;
    float worldY = (float(y) / float(pc.height)) * pc.scale + pc.offsetY;
    float worldZ = (float(z) / float(pc.depth)) * pc.scale + pc.offsetZ;

    uint index = x + y * pc.width + z * pc.width * pc.height;

    float noiseValue = 0.0;
    int octaves = clamp(int(pc.octaves), 1, 6);
    float persistence = pc.persistence;
    float lacunarity = pc.lacunarity;

    if (pc.dimension == 3) {
        if (octaves == 1) {
            noiseValue = Noise3D(worldX, worldY, worldZ);
        } else {
            noiseValue = FBM3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
        }
    }

    noiseValues[index] = noiseValue;
}
