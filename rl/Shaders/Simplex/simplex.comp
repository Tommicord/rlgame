#version 450

#include "simplex.noise.constants.glsl"
#include "simplex.gradients.glsl"
#include "simplex.perm.glsl"
#include "simplex.common.glsl"
#include "simplex.noise2d.glsl"
#include "simplex.noise3d.glsl"
#include "simplex.octaves.glsl"

layout (local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

shared int cachedPerm[264];
shared int cachedPermGradIndex3D[264];

// Output buffer for noise values
layout(std430, binding = 2) buffer NoiseBuffer {
    float noiseValues[];
};

// Noise generation parameters
layout(push_constant) uniform PushConstants {
    uint dimension;      // 2 or 3
    float scale;         // Noise scale
    float offsetX;       // X offset
    float offsetY;       // Y offset
    float offsetZ;       // Z offset
    uint width;          // Grid width
    uint height;         // Grid height
    uint depth;          // Grid depth
    uint time;           // Time offset for animated noise
    uint octaves;        // Number of octaves for FBM (default: 1)
    float persistence;   // Amplitude multiplier per octave (default: 0.5)
    float lacunarity;    // Frequency multiplier per octave (default: 2.0)
    uint noiseType;      // 0: Standard, 1: FBM, 2: Ridged, 3: Turbulence
} pc;

void main() {
    uint localId = gl_LocalInvocationIndex;
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;

    // Cooperative loading of permutation and gradient tables into shared memory
    if (localId < 256) {
        cachedPerm[localId] = perm[localId];
        cachedPermGradIndex3D[localId] = permGradIndex3D[localId];
    }
    // Pad remaining elements to avoid bank conflicts
    if (localId < 8) {
        cachedPerm[256 + localId] = 0;
        cachedPermGradIndex3D[256 + localId] = 0;
    }
    memoryBarrierShared();
    barrier();

    // Check bounds
    if (x >= pc.width || y >= pc.height || z >= pc.depth) {
        return;
    }

    float worldX = (float(x) / float(pc.width)) * pc.scale + pc.offsetX;
    float worldY = (float(y) / float(pc.height)) * pc.scale + pc.offsetY;
    float worldZ = (float(z) / float(pc.depth)) * pc.scale + pc.offsetZ;

    uint index = x + y * pc.width + z * pc.width * pc.height;

    float noiseValue = 0.0;
    
    // Default values for single octave
    int octaves = clamp(int(pc.octaves), 1, 6);
    float persistence = pc.persistence;
    float lacunarity = pc.lacunarity;
    
    // Ensure at least 1 octave
    if (octaves < 1) {
        octaves = 1;
    }

    if (pc.dimension == 2) {
        if (pc.noiseType == 0) {
            // Standard noise
            if (octaves == 1) {
                noiseValue = Noise2D(worldX, worldY);
            } else {
                noiseValue = FBM2D(worldX, worldY, octaves, persistence, lacunarity);
            }
        } else if (pc.noiseType == 1) {
            // FBM
            noiseValue = FBM2D(worldX, worldY, octaves, persistence, lacunarity);
        } else if (pc.noiseType == 2) {
            // Ridged
            noiseValue = RidgedNoise2D(worldX, worldY, octaves, persistence, lacunarity);
        } else if (pc.noiseType == 3) {
            // Turbulence
            noiseValue = Turbulence2D(worldX, worldY, octaves, persistence, lacunarity);
        } else {
            // Default to FBM
            noiseValue = FBM2D(worldX, worldY, octaves, persistence, lacunarity);
        }
    } else if (pc.dimension == 3) {
        if (pc.noiseType == 0) {
            // Standard noise
            if (octaves == 1) {
                noiseValue = Noise3D(worldX, worldY, worldZ);
            } else {
                noiseValue = FBM3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
            }
        } else if (pc.noiseType == 1) {
            // FBM
            noiseValue = FBM3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
        } else if (pc.noiseType == 2) {
            // Ridged
            noiseValue = RidgedNoise3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
        } else if (pc.noiseType == 3) {
            // Turbulence
            noiseValue = Turbulence3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
        } else {
            // Default to FBM
            noiseValue = FBM3D(worldX, worldY, worldZ, octaves, persistence, lacunarity);
        }
    }

    noiseValues[index] = noiseValue;
}
