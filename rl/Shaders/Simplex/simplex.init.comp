#version 450

layout (local_size_x = 256) in;

layout(std430, binding = 0) buffer PermutationBuffer {
    int perm[256];
};

layout(std430, binding = 1) buffer PermGradIndex3DBuffer {
    int permGradIndex3D[256];
};

layout(push_constant) uniform PushConstants {
    uint seed;
} pc;

shared int cachedSource[256];

uint LCG(uint state) {
    return state * 1664525u + 1013904223u;
}

void main() {
    uint localID = gl_LocalInvocationIndex;
    if (localID < 256) {
        cachedSource[localID] = int(localID);
    }
    barrier();
    if (localID == 0) {
        uint currentSeed = pc.seed;
        currentSeed = LCG(currentSeed);
        currentSeed = LCG(currentSeed);
        currentSeed = LCG(currentSeed);

        for (int i = 255; i >= 0; i--) {
            currentSeed = LCG(currentSeed);
            int r = int((currentSeed + 31u) % uint(i + 1));
            if (r < 0) {
                r += (i + 1);
            }
            int pickedValue = cachedSource[r];
            perm[i] = pickedValue;
            permGradIndex3D[i] = (pickedValue % 24) * 3;
            cachedSource[r] = cachedSource[i];
        }
    }
}
